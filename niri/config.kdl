input {
    mouse {
        natural-scroll
        accel-speed 1
        accel-profile "flat"
    }
    trackball {
        natural-scroll
        accel-speed 0.9
        accel-profile "flat"
    }

    touchpad {
        natural-scroll
    }
}

output "DP-1" {
    mode "2560x1440"
    transform "180"
    position x=0 y=-1440

    hot-corners {
        off
    }

    layout {
        preset-column-widths {
            proportion 0.5
            proportion 1.0
        }

        default-column-width {
            proportion 1.0
        }
    }
}

output "DP-2" {
    mode "2560x1440@143.973"
    focus-at-startup
    position x=0 y=0

    hot-corners {
        off
    }
}

layout {
    gaps 8

    center-focused-column "never"
    always-center-single-column
    background-color "transparent"

    preset-column-widths {
        proportion 0.5
        proportion 0.75
    }

    default-column-width {
        proportion 0.75
    }

    focus-ring {
        on
        width 2
        active-color "#8aadf4"
        urgent-color "#ee99a0"
    }

    tab-indicator {
        place-within-column
        position "right"
        gap -12
    }

    border {
        off
    }

    shadow {
        off
    }
}

spawn-at-startup "noctalia"

cursor {
    xcursor-theme "catppuccin-macchiato-dark-cursors"
    xcursor-size 32

    hide-when-typing
    hide-after-inactive-ms 5000
}

overview {
    workspace-shadow {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/pictures/screenshots/screenshot-%Y-%m-%d %H-%M-%S.png"

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="Proton Pass"
    match app-id="steam" title="Friends List"

    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="app.zen_browser.zen" title="Picture-in-Picture"

    open-floating true
    default-window-height { proportion 0.6; }
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="org.gnome.NautilusPreviewer"

    open-floating true
    default-window-height { proportion 1.0; }
    default-column-width { proportion 0.75; }
}

window-rule {
    match app-id="steam_app_default" title="World of Warcraft"

    open-fullscreen true
    open-focused true
}

window-rule {
    match app-id="app.zen_browser.zen"
    match app-id="discord"
    match app-id="steam_app_default" title="Battle.net"
    match app-id="steam_app_default" title="Battle.net - Chats and Groups"


    block-out-from "screencast"
}

window-rule {
    match app-id="dev.noctalia.Noctalia.Settings"
    match app-id="proton-pass"

    default-column-width { proportion 0.5; }
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

recent-windows {
    off
}

include "binds.kdl"
